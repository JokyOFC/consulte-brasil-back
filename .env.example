APP_NAME="Consulte Brasil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Deve ser >= session_timeout_minutes máximo do admin (1440 min).
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Atrás de load balancer / reverse proxy (nginx, ALB, Cloudflare):
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# APIBrasil (https://doc.apibrasil.io) — provedor de dados por créditos.
# Bearer Token: painel > Credenciais. DeviceToken: painel > Dispositivos (um por serviço).
API_BRASIL_BASE_URL=https://gateway.apibrasil.io/api/v2
API_BRASIL_TOKEN=
API_BRASIL_SANDBOX_TOKEN=
API_BRASIL_TIMEOUT=8
API_BRASIL_DEVICE_TOKEN_CPF=
API_BRASIL_DEVICE_TOKEN_CNPJ=
# DeviceTokens por grupo de serviço do catálogo APIBrasil (doc.apibrasil.io).
API_BRASIL_DEVICE_TOKEN_VEHICLES=
API_BRASIL_DEVICE_TOKEN_CEP=
API_BRASIL_DEVICE_TOKEN_FIPE=
API_BRASIL_DEVICE_TOKEN_HOLIDAYS=
API_BRASIL_DEVICE_TOKEN_DDD=
API_BRASIL_DEVICE_TOKEN_CORREIOS=
API_BRASIL_DEVICE_TOKEN_GEOLOCATION=
API_BRASIL_DEVICE_TOKEN_GEOMATRIX=
API_BRASIL_DEVICE_TOKEN_WEATHER=
API_BRASIL_DEVICE_TOKEN_DATABASE=
API_BRASIL_DEVICE_TOKEN_IA=
API_BRASIL_DEVICE_TOKEN_SMS=
API_BRASIL_DEVICE_TOKEN_CHIP=
API_BRASIL_DEVICE_TOKEN_URA=

# CPF.CNPJ (https://www.cpfcnpj.com.br/dev) — provedor de dados por créditos.
# Token: painel > API > Tokens. Pacote = tier de dados (ver doc).
# Token de testes (dados fictícios): 5ae973d7a997af13f0aaf2bf60e65803
CPFCNPJ_BASE_URL=https://api.cpfcnpj.com.br
CPFCNPJ_TOKEN=
CPFCNPJ_SANDBOX_TOKEN=5ae973d7a997af13f0aaf2bf60e65803
CPFCNPJ_TIMEOUT=60
CPFCNPJ_PACKAGE_CPF=2
CPFCNPJ_PACKAGE_CNPJ=6

# Mercado Pago (https://www.mercadopago.com.br/developers) — pagamentos.
# Credenciais: painel > Suas integrações > Credenciais (teste e produção).
# O ambiente é controlado pelo provider "mercado_pago" (sandbox|production).
MP_ACCESS_TOKEN=
MP_SANDBOX_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SANDBOX_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_TIMEOUT=20
MP_PIX_EXPIRATION_MINUTES=30
MP_BOLETO_EXPIRATION_DAYS=3

# TTL padrão do cache de consultas (segundos). Tipos podem sobrescrever via query_types.cache_ttl_seconds.
# 86400 = 24h. Use 0 para desabilitar quando o tipo não define TTL próprio.
CONSULTATION_CACHE_TTL_SECONDS=86400
